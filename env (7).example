# Database. Defaults to local SQLite file so the project runs with zero setup.
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/civicsense
DATABASE_URL=sqlite:///./civicsense.db

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: enables Gemini-powered image classification.
# If unset, the app automatically falls back to a local OpenCV heuristic
# classifier so AI detection works fully offline with zero paid APIs.
GEMINI_API_KEY=

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Duplicate-detection radius (meters) and time window (hours)
DUPLICATE_RADIUS_METERS=100
DUPLICATE_WINDOW_HOURS=72
